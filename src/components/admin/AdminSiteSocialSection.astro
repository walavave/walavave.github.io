---
import type { SiteSocialIconKey } from '../../lib/theme-settings';
import AdminSocialCustomRowTemplate from './AdminSocialCustomRowTemplate.astro';

interface Props {
  socialCustomLimit: number;
}

const { socialCustomLimit } = Astro.props;

type SocialIconOption = {
  value: SiteSocialIconKey;
  label: string;
};

const socialIconOptions: readonly SocialIconOption[] = [
  { value: 'github', label: 'GitHub' },
  { value: 'x', label: 'X' },
  { value: 'email', label: 'Email' },
  { value: 'weibo', label: '微博' },
  { value: 'zhihu', label: '知乎' },
  { value: 'wechat', label: '微信公众号' },
  { value: 'xiaohongshu', label: '小红书' },
  { value: 'facebook', label: 'Facebook' },
  { value: 'instagram', label: 'Instagram' },
  { value: 'telegram', label: 'Telegram' },
  { value: 'mastodon', label: 'Mastodon' },
  { value: 'bilibili', label: 'Bilibili' },
  { value: 'youtube', label: 'YouTube' },
  { value: 'linkedin', label: 'LinkedIn' },
  { value: 'website', label: '网站' }
];
const defaultCustomSocialIconKey: SiteSocialIconKey = socialIconOptions[0]?.value ?? 'website';
---

<div class="admin-subgroup">
  <div class="admin-social-panel">
    <!-- 预置社交链接由控制器统一读写；保留为隐藏字段以兼容旧版自定义链接面板。 -->
    <input id="site-social-github-order" type="hidden" value="1" />
    <input id="site-social-github" type="hidden" />
    <input id="site-social-x-order" type="hidden" value="2" />
    <input id="site-social-x" type="hidden" />
    <input id="site-social-email-order" type="hidden" value="3" />
    <input id="site-social-email" type="hidden" />
    <div class="admin-social-panel__head">
      <p class="admin-subtitle admin-subtitle--compact">
        <span class="admin-subtitle__main">社交链接</span>
        <span id="site-social-custom-count" class="admin-subtitle__hint admin-social-count">
          (0 / {socialCustomLimit})
        </span>
      </p>
      <div class="admin-social-actions">
        <button id="site-social-custom-add" class="admin-btn admin-btn--ghost admin-btn--compact" type="button">
          新增链接
        </button>
      </div>
    </div>
    <div class="admin-social-table">
      <div id="site-social-custom-head" class="admin-social-header" aria-hidden="true">
        <span class="admin-social-header__order">位置</span>
        <span class="admin-social-header__platform">平台</span>
        <span class="admin-social-header__icon">图标</span>
        <span class="admin-social-header__href">链接地址</span>
        <span class="admin-social-header__actions">操作</span>
      </div>
      <div id="site-social-custom-list" class="admin-social-list"></div>
    </div>
  </div>

  <AdminSocialCustomRowTemplate
    socialIconOptions={socialIconOptions}
    customSocialIconOptions={socialIconOptions}
    defaultCustomSocialIconKey={defaultCustomSocialIconKey}
  />
</div>
